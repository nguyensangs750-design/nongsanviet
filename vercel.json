{
  "version": 2,
  "builds": [
    {
      "src": "api/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/server"
    },
    {
      "src": "/admin-dashboard",
      "dest": "/api/server"
    },
    {
      "src": "/(.*)",
      "dest": "/api/server"
    }
  ]
}